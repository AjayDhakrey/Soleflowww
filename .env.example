# =============================================================================
# SoleFlow — Production & Development Environment Configuration
# =============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Supabase Database & Auth (Client & Admin)
# Project URL (e.g. https://jpcaptmmcbuqlgrdetde.supabase.co)
VITE_SUPABASE_URL=https://jpcaptmmcbuqlgrdetde.supabase.co
# Supabase Public Anon Key (for browser/frontend queries governed by RLS)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Supabase Service Role Key (Keep secret! Used ONLY by Express backend for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Backend API Endpoint (Used by frontend to reach Express API proxy)
VITE_API_URL=http://localhost:3001

# Gemini AI / LLM Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here

# Demo / Offline Resilience Mode (Set to true to fall back to mock data if offline)
VITE_DEMO_MODE=false
